<?xml version="1.0" encoding="utf-8"?>
<!-- RelativeLayout, not ConstraintLayout: the app carries no androidx at all. What the
     constraints were doing here is anchor-based (below the app bar, along the bottom
     edge, to the left of the Run pill), which RelativeLayout says directly. The only
     percentage geometry was the Run pill's 26% left edge and 48% width, and
     MainActivity already computes both in pixels (setCompactButton measures the parent),
     so the guideline has simply moved into that code. -->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:fitsSystemWindows="true">

        <android.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:contentInsetStart="0dp"
            android:contentInsetStartWithNavigation="0dp"
            android:title="KurwaSu"
            android:titleMarginStart="32dp">

            <!-- OneUI-style overflow button: grey circle, right edge aligned
                 with the card toggles below (32dp from screen edge). -->
            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_circle"
                android:contentDescription="Menu"
                android:scaleType="center"
                android:src="@drawable/ic_more" />

            <FrameLayout
                android:id="@+id/updatePill"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="32dp"
                android:background="@drawable/bg_update_pill"
                android:clickable="true"
                android:contentDescription="Update available, open the release page"
                android:focusable="true"
                android:visibility="gone">

                <TextView
                    android:id="@+id/updateLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="start|center_vertical"
                    android:gravity="center"
                    android:text="Update"
                    android:textColor="#FF101418"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <LinearLayout
                android:id="@+id/odinPill"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_odin_pill"
                android:clickable="true"
                android:contentDescription="Recovery mode: toggle download-mode authorisation"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minWidth="44dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <View
                    android:id="@+id/odinDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="#FF6E6E6E" />

                <TextView
                    android:id="@+id/odinLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Recovery"
                    android:textColor="#FFD9D9D9"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </android.widget.Toolbar>

    </FrameLayout>

    <!-- Invisible anchor for the popup menu -->
    <View
        android:id="@+id/menuAnchor"
        android:layout_width="8dp"
        android:layout_height="2dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="8dp"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/appBarLayout" />

    <df.root.CardStackLayout
        android:id="@+id/cardStack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/appBarLayout"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- SU Manager picker -->
        <df.root.DraggableCardView
            android:id="@+id/cardSuManager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FF1C1C1C"
            app:cardCornerRadius="26dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:id="@+id/rowSuManager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/card_row_ripple"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SU Manager"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/suManagerSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Not selected - required"
                        android:textColor="#FF9E9E9E"
                        android:textSize="12sp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/chevronSuManager"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="Select"
                    android:src="@drawable/ic_chevron" />

            </LinearLayout>

        </df.root.DraggableCardView>

        <df.root.DraggableCardView
            android:id="@+id/cardBoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FF1C1C1C"
            app:cardCornerRadius="26dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAutorunTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Autorun"
                            android:textColor="#FFFFFFFF"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvAutorunDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Runs the exploit after boot"
                            android:textColor="#FF9E9E9E"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <df.root.OneUiSwitch
                        android:id="@+id/switchBootStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRebootTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Auto reboot"
                            android:textColor="#FFFFFFFF"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvRebootDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Soft reboots after root"
                            android:textColor="#FF9E9E9E"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <df.root.OneUiSwitch
                        android:id="@+id/switchAutoSoftReboot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical" />

                </LinearLayout>

            </LinearLayout>

        </df.root.DraggableCardView>

        <df.root.DraggableCardView
            android:id="@+id/cardModules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FF1C1C1C"
            app:cardCornerRadius="26dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="KernelSU Modules"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/modulesSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Enabled - active at next reboot"
                        android:textColor="#FF9E9E9E"
                        android:textSize="12sp" />

                </LinearLayout>

                <df.root.OneUiSwitch
                    android:id="@+id/switchModules"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:checked="true" />

            </LinearLayout>

        </df.root.DraggableCardView>

        <df.root.DraggableCardView
            android:id="@+id/cardLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FF1C1C1C"
            app:cardCornerRadius="26dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Show advanced log"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Shows full scrollable log"
                        android:textColor="#FF9E9E9E"
                        android:textSize="12sp" />

                </LinearLayout>

                <df.root.OneUiSwitch
                    android:id="@+id/switchAdvancedLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical" />

            </LinearLayout>

        </df.root.DraggableCardView>

    </df.root.CardStackLayout>

    <!-- ВОССТАНОВЛЕННЫЕ КОМПОНЕНТЫ, КОТОРЫЕ ИЩЕТ JAVA-КОД (логи, кнопки, пилюли, диммер) -->
    
    <!-- Диммер фона -->
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <!-- Окно расширенного лога / консоль -->
    <FrameLayout
        android:id="@+id/logWindow"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_alignParentBottom="true"
        android:background="#FF111111"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/outputScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">

            <TextView
                android:id="@+id/outputView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="KurwaSu log initialized...\n"
                android:textColor="#FF00FF00"
                android:textSize="12sp" />
        </ScrollView>
    </FrameLayout>

    <!-- Кнопка шаринга логов -->
    <ImageButton
        android:id="@+id/btnShareLog"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:background="@drawable/bg_circle"
        android:contentDescription="Share Log"
        android:src="@drawable/ic_share"
        android:visibility="gone" />

    <!-- Дополнительные элементы для KSU и шагов -->
    <ImageView
        android:id="@+id/ksuChevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ksuLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <View
        android:id="@+id/twoStep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</RelativeLayout>
