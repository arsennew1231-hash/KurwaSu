<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:fitsSystemWindows="true">

        <android.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:contentInsetStart="0dp"
            android:contentInsetStartWithNavigation="0dp"
            android:title="KurwaSu"
            android:titleMarginStart="32dp"
            android:titleTextAppearance="@style/ToolbarTitle">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_circle"
                android:contentDescription="Menu"
                android:scaleType="center"
                android:src="@drawable/ic_more" />

            <FrameLayout
                android:id="@+id/updatePill"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="32dp"
                android:background="@drawable/bg_update_pill"
                android:clickable="true"
                android:contentDescription="Update available"
                android:focusable="true"
                android:visibility="gone">

                <TextView
                    android:id="@+id/updateLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="start|center_vertical"
                    android:gravity="center"
                    android:text="Update"
                    android:textColor="#FF101418"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <LinearLayout
                android:id="@+id/odinPill"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_odin_pill"
                android:clickable="true"
                android:contentDescription="Recovery mode"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minWidth="44dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <View
                    android:id="@+id/odinDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="#FF6E6E6E" />

                <TextView
                    android:id="@+id/odinLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Recovery"
                    android:textColor="#FFD9D9D9"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </android.widget.Toolbar>

    </FrameLayout>

    <View
        android:id="@+id/menuAnchor"
        android:layout_width="8dp"
        android:layout_height="2dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="8dp"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/appBarLayout" />

    <!-- Затемнение фона при необходимости -->
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#99000000" />

    <!-- Основной контейнер карточек и элементов управления -->
    <RelativeLayout
        android:id="@+id/logWindow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/appBarLayout"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/twoStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Кнопки управления эксплойтом и SU -->
            <Button
                android:id="@+id/btnKsu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SU Manager / KSU" />

            <Button
                android:id="@+id/btnRun"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Run Exploit" />

            <Button
                android:id="@+id/btnShareLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Share Log" />

        </LinearLayout>

        <!-- Блок шеврона и статуса -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/twoStep"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ksuLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Status"
                android:textColor="#FFFFFFFF" />

            <ImageView
                android:id="@+id/ksuChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron" />

        </LinearLayout>

        <!-- Окно логов с прокруткой -->
        <ScrollView
            android:id="@+id/outputScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/twoStep"
            android:layout_marginTop="60dp"
            android:fillViewport="true">

            <TextView
                android:id="@+id/outputView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text=""
                android:textColor="#FF00FF00"
                android:textSize="12sp" />

        </ScrollView>

    </RelativeLayout>

</RelativeLayout>
